# Hardened sandbox image for isolated candidate verification (Phase 05)
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install required tools and testing dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# Pre-install pytest and flake8 for zero-network (--network none) verification runs
RUN pip install --no-cache-dir \
    pytest==9.1.1 \
    flake8==7.4.1 \
    flask==3.0.3 \
    requests==2.32.3

# Create unprivileged sandbox user (UID:GID 1000:1000)
RUN useradd -m -u 1000 -s /bin/bash sandboxuser

USER 1000:1000
WORKDIR /workspace
